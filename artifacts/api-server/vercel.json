{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,

  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "node build.mjs",

  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**"
    }
  },

  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],

  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
