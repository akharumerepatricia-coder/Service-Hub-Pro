{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/canvica-crm run build",
  "outputDirectory": "artifacts/canvica-crm/dist/public",
  "installCommand": "pnpm install",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
